        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@hathway/analytics": "*",
        "effect": "4.0.0-rc.112",
        "posthog-node": "5.54.1",
        "server-only": "^0.0.1"
    },
    "devDependencies": {
        "@effect/vitest": "4.0.0-rc.112",
        "typescript": "^5",
        "vitest": "^4.1.11"
    }
}
