{
    "name": "@hathway/ui",
    "version": "0.0.1",
    "private": true,
    "//": "shadcn/ui(Base UI) 컴포넌트 저장소. 컴포넌트 TSX 와 3층 CSS(src/systems/<system>) 는 tyohnn CLI 가 소유한다 — 정본은 저장소 루트 tyohnn.json 이고, 손으로 고치는 대신 tyohnn 저장소에서 고쳐 다시 받는다.",
    "exports": {
        "./components/*": "./src/components/*.tsx",
        "./lib/*": "./src/lib/*.ts",
        "./hooks/*": "./src/hooks/*.ts",
        "./product.css": "./src/product.css",
        "./icons": "./src/icons/index.ts",
        "./icons/names": "./src/icons/names.ts",
        "./systems/*": "./src/systems/*",
        "./strings": "./src/strings/index.ts",
        "./blocks/*": "./src/blocks/*.tsx",
        "./blocks/lib/*": "./src/blocks/lib/*.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "node scripts/scan-tokens.mjs",
        "check:tokens": "node scripts/scan-tokens.mjs"
    },
    "dependencies": {
        "@base-ui/react": "1.8.0",
        "@phosphor-icons/react": "^2.1.10",
        "@shadcn/react": "^0.3.1",
        "class-variance-authority": "^0.7.1",
        "cmdk": "^1.1.1",
        "cn": "0.2.5",
        "date-fns": "^4.4.0",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.5.0",
        "lucide-react": "^1.41.0",
        "next-themes": "^0.4.6",
        "react": "^19.2.1",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.2.1",
        "react-is": "^19.3.0",
        "react-resizable-panels": "^4.12.3",
        "recharts": "^3.8.0",
        "shadcn": "^4.21.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "tailwindcss": "^4",
        "typescript": "^5"
    }
}
