{
    "name": "@investment/shared",
    "version": "0.0.1",
    "private": true,
    "//": "도메인이 아닌 공용 모듈. 새 공용 코드를 여기에 계속 더하지 말고, 도메인 코드는 그 도메인 패키지에 둔다. React/DB/Next 의존 금지.",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./constants/*": "./src/constants/*.ts",
        "./utils/*": "./src/utils/*.ts",
        "./invariants/*": "./src/invariants/*.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests"
    },
    "dependencies": {
        "dayjs": "^1.11.19"
    },
    "devDependencies": {
        "vitest": "^4.1.11",
        "typescript": "^5"
    }
}
