{
    "$schema": "https://turbo.build/schema.json",
    "extends": ["//"],
    "tasks": {
        "test": {
            // ⚠ 이 패키지의 검사 넷(불변식 인용 · 주석 · 마이그레이션 · 의존 방향)은 저장소 전체를 읽는다.
            //    turbo 는 package.json 의 의존만 보므로 적지 않으면 다른 패키지를 고쳐도 해시가 그대로이고,
            //    캐시가 이전 결과를 돌려주어 검사가 돌지 않은 채 초록이 된다(2026-09-28 실측).
            //    넓게 `apps/**` 로 적지 않는 것은 명시한 글롭이 .gitignore 를 따르지 않아서다.
            //    tsbuildinfo 와 .env 까지 해시에 들어가면 같은 코드에서도 캐시가 맞지 않는다.
            //    검사가 읽는 자리를 넓히면 여기에도 같은 줄을 더한다.
            //    의존 검사(check-dependencies)는 워크스페이스마다 package.json 과 scripts · test 와 뿌리의 설정
            //    파일까지 읽는다. 마지막 줄은 next build 가 만드는 workflow 폴더를 뺀다. 빌드 뒤에 캐시가
            //    어긋나는 까닭은 apps/agent/turbo.json 에 있다
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/apps/*/src/**",
                "$TURBO_ROOT$/apps/*/e2e/**",
                "$TURBO_ROOT$/packages/*/src/**",
                "$TURBO_ROOT$/supabase/migrations/**",
                "$TURBO_ROOT$/apps/*/package.json",
                "$TURBO_ROOT$/packages/*/package.json",
                "$TURBO_ROOT$/apps/*/scripts/**",
                "$TURBO_ROOT$/packages/*/scripts/**",
                "$TURBO_ROOT$/apps/*/test/**",
                "$TURBO_ROOT$/packages/*/test/**",
                "$TURBO_ROOT$/apps/*/*.config.*",
                "$TURBO_ROOT$/packages/*/*.config.*",
                "!$TURBO_ROOT$/apps/*/src/app/.well-known/workflow/**"
            ]
        }
    }
}
