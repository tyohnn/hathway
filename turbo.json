{
    "$schema": "https://turbo.build/schema.json",
    // turbo 가 AI 에이전트를 알아보면 루트 AGENTS.md 에 안내 블록을 써 넣는다. 그 파일은 이 저장소의 교재 · 리서치 규약이라 끈다
    "agentGuidance": false,
    // 워크스페이스의 tsconfig 대부분이 이 파일을 extends 한다. turbo 는 워크스페이스 밖의 파일을 보지
    // 않으므로 적지 않으면 컴파일 옵션을 바꿔도 typecheck 가 이전 결과를 캐시에서 돌려준다.
    // 패키지 하나가 저장소의 다른 자리를 읽는 경우는 그 패키지의 turbo.json 이 inputs 로 적는다
    "globalDependencies": ["tsconfig.base.json"],
    // turbo 는 Next 프레임워크 추론으로 NEXT_PUBLIC_* 를 자동 포함한다. 명시 리스트로 교체하는 것만으로는
    // 해시에서 뺄 수 없고, 배포마다 값이 바뀌는 Vercel 시스템 변수는 네게이션으로만 제외된다.
    "globalEnv": [
        "NEXT_PUBLIC_*",
        "!NEXT_PUBLIC_VERCEL_URL",
        "!NEXT_PUBLIC_VERCEL_BRANCH_URL",
        "!NEXT_PUBLIC_VERCEL_GIT_*",
        "VERCEL_ENV"
    ],
    "globalPassThroughEnv": [
        "AGENT_DATABASE_URL",
        "OWNER_DATABASE_URL",
        // 게이트웨이를 실제로 지나는 검사가 이 값을 읽는다. 없으면 그 검사가 스스로 건너뛰므로
        // CI 는 그대로 초록이고, 손에 있는 사람은 돌릴 때마다 실물을 잰다
        "AI_GATEWAY_API_KEY",
        "AGENT_RUNNER",
        // 밖으로 나가는 검사가 프록시 뒤에서도 돌게 한다. turbo 는 이 변수들을 걸러 내는데, 그러면
        // 게이트웨이 검사가 열쇠는 쥔 채 연결에서 실패해 「모델이 답하지 않는다」처럼 읽힌다
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "no_proxy",
        "NODE_EXTRA_CA_CERTS",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
    ],
    "tasks": {
        "dev": {
            "persistent": true,
            "cache": false
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".next/**", "!.next/cache/**", "dist/**"]
        },
        "lint": {},
        // 테스트는 파일을 만들지 않으므로 outputs 는 비운다. `^build` 는 의존 패키지의
        // 산출물이 필요한 경우를 위한 것이다.
        "test": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "typecheck": {
            // ^build 는 build 스크립트가 없는 패키지에서 no-op 이 된다. ^typecheck 로 두어
            // 의존 패키지의 타입 검증이 선행되게 한다.
            "dependsOn": ["^typecheck"]
        }
    }
}
