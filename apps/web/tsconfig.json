{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // 앱은 워크스페이스 패키지의 **소스**를 그대로 읽는다(빌드 산출물이 없다). 그 패키지 안에서 모듈끼리
    // 서로를 `./x.ts` 로 부르므로, 앱 쪽에서도 이 옵션이 켜져 있어야 그 import 를 따라갈 수 있다.
    // noEmit 과 함께여야 허용되는 옵션이고, 이 앱은 타입 검사만 하므로 조건이 맞는다.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@hathway/ui/icons": [
        "../../packages/ui/src/icons/libraries/phosphor.tsx"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
