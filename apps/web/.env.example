# web 앱의 환경 변수 본보기.
#
# `cp apps/web/.env.example apps/web/.env.development.local` 로 복사하면
# `npx turbo dev --filter=@hathway/web` 가 바로 돈다(포트 4400). 아래 값은 로컬 스택의
# 기본값이고 비밀이 아니다. 로컬 스택은 저장소 루트의 CLAUDE.md 가 적어 둔 `supabase start` 로 띄운다.
#
# ⚠ `.env.development.local` 은 `next dev` 전용이다. `next build` 와 `next start` 는 읽지 않으므로,
#    프로덕션 빌드를 손으로 띄울 때는 같은 값을 명령줄에 함께 넘긴다.

# 세션을 확인한다. 이 둘은 브라우저 번들에 박히므로 배포에서도 Production 과 Preview 양쪽에 건다.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54361
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# 공시 본문을 Storage 에서 받는다(`src/lib/marketRuntime.ts`). 서버 전용이고 `NEXT_PUBLIC_` 을 붙이지 않는다.
# 아래는 `supabase start` 의 데모 키라 비밀이 아니다. 배포에서는 그 프로젝트의 service_role 키를 넣는다.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# 이 서비스의 공개 주소. 문서의 MCP 연결 명령에 들어간다(`src/lib/site.ts`). 배포에서는 실제 주소를 넣는다.
NEXT_PUBLIC_SITE_URL=http://localhost:4400

# `pg` 로 직결한다. 접속 롤은 `web_app` 이고 로컬 비밀번호는 `supabase/seed.sql` 이 넣는다.
WEB_DATABASE_URL=postgresql://web_app:postgres@127.0.0.1:54362/postgres


# scaffold:module posthog begin
# 제품 분석(`src/modules/posthog/config.ts`). `rehearsal` 이면 PostHog 로 보내지 않고 이 서버와 브라우저의 메모리에 모은다.
# 실물로 보내려면 이 줄을 지우고 프로젝트 토큰과 리전(us · eu)을 넣는다. 토큰은 공개해도 되는 값이다.
NEXT_PUBLIC_POSTHOG_SINK=rehearsal
# NEXT_PUBLIC_POSTHOG_TOKEN=phc_…
# NEXT_PUBLIC_POSTHOG_REGION=us
# scaffold:module posthog end

# scaffold:module plugin begin
# 플러그인의 폼이 되물을 때 맡기는 상태를 서명하는 비밀(`src/modules/plugin/requestState.ts`). 없으면 폼을 내지 않고 글로
# 안내한다. 아래 값은 로컬 전용이고, 배포에서는 길고 무작위인 값을 따로 넣는다.
PLUGIN_STATE_SECRET=hathway-local-plugin-state
# 디렉터리에 올린 뒤에 아는 플러그인의 id(`chatgpt.com/plugins/<id>`). 넣으면 도구의 답에 그 쪽지로 가는 딥링크가 실린다.
# PLUGIN_DIRECTORY_ID=plugin_asdk_app_…
# scaffold:module plugin end

# 쪽지 요약이 쓸 모델(`src/lib/summaryModel.ts`). `rehearsal` 이면 모델을 부르지 않는다. 실물은 이 줄을 지우고
# 터미널에서 `.env.local` 에 `AI_GATEWAY_API_KEY` 를 넣는다.
SUMMARY_RUNNER=rehearsal

# ── 배포에 넣는 값 ────────────────────────────────────────────────────────
#
#   NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<대시보드의 anon 키>
#   SUPABASE_SERVICE_KEY=…           공시 본문(Storage). 서버 전용
#   WEB_DATABASE_URL=postgresql://web_app.<project-ref>:<비밀번호>@<풀러 호스트>:6543/postgres?uselibpqcompat=true&sslmode=require
#   AI_GATEWAY_API_KEY=…             쪽지 요약
#   PLUGIN_STATE_SECRET=…            플러그인의 폼 상태를 서명하는 비밀. `openssl rand -base64 32` 로 만든다 scaffold:module plugin
#   NEXT_PUBLIC_POSTHOG_TOKEN=phc_…  제품 분석의 프로젝트 토큰. 리전이 유럽이면 NEXT_PUBLIC_POSTHOG_REGION=eu 도 scaffold:module posthog
#
# ⚠ 포트는 6543(트랜잭션 모드)이다. 5432(세션 모드)를 쓰면 얼어 있는 서버리스 인스턴스가
#    Postgres 커넥션을 붙잡는다.
# ⚠ `web_app` 의 LOGIN 과 BYPASSRLS 와 비밀번호는 마이그레이션이 만들지 않는다. 원격은 Management API 로
#    넣는다(`docs/supabase-migrations/README.md`).
# ⚠ Supabase Auth 의 Redirect URLs 에 `https://<배포 호스트>/auth/callback` 을 더해야 구글 로그인이 돌아온다.

# ── 배포에 넣지 않는 것 ──────────────────────────────────────────────────
#
# ALLOW_LOCAL_ACCOUNTS=1
#   프로덕션 빌드에서 로컬 계정 로그인 칸을 여는 유일한 스위치다(`src/lib/localAccounts.ts`).
#   배포 환경변수에 들어가면 시드 계정으로 누구나 들어온다. e2e 가 쓰는 자리다.
#
# EXPOSE_TESTING_API=1
#   e2e 가 내비게이션을 재는 테스트 API 를 연다. 그 값을 넘기는 곳은 `playwright.config.ts` 뿐이다.
