# web 앱의 환경 변수 본보기.
#
# `cp apps/web/.env.example apps/web/.env.local` 로 복사하면 `pnpm dev` 가 로컬 스택(platform/, 5436x)에 붙는다.
# 아래 값은 로컬 스택의 기본값이고 비밀이 아니다. 스택을 띄우고 로그인 시드를 넣는 법은 platform/README.md 에 있다.

# 로그인(Auth)과 저장소(Storage)가 붙는 주소. 이 둘은 브라우저 번들에 실린다.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54361
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# 공시 본문 조각을 저장소에서 읽는 service role 키. 서버만 읽는다. 표를 읽는 데는 쓰지 않는다.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# 종목 · 재무 · 공시 조회와 리서치 보드와 계정 명부는 `pg` 로 직결한다. 접속 롤은 `web_app` 이고 로컬 비밀번호는
# `platform/supabase/seeds/org.sql` 이 넣는다.
WEB_DATABASE_URL=postgresql://web_app:postgres@127.0.0.1:54362/postgres

# ── 배포에 넣는 값 ────────────────────────────────────────────────────────
#
#   NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<대시보드의 anon 키>
#   SUPABASE_SERVICE_KEY=<대시보드의 service role 키>
#   WEB_DATABASE_URL=postgresql://web_app.<project-ref>:<비밀번호>@<풀러 호스트>:6543/postgres?uselibpqcompat=true&sslmode=require
#
# ⚠ 포트는 6543(트랜잭션 모드)이다. 5432(세션 모드)를 쓰면 얼어 있는 서버리스 인스턴스가 Postgres 커넥션을 붙잡는다.
# ⚠ `web_app` 의 LOGIN 과 BYPASSRLS 와 비밀번호는 마이그레이션이 만들지 않는다. 원격은 소유자가 따로 넣는다
#    (platform/README.md 「로그인과 앱 롤」).
# ⚠ `WEB_DATABASE_URL` 이 없으면 교재만 선다. 종목 화면은 500 이고 리서치 보드 목록이 비고 보드를 만들거나 고칠 수 없다.
# ⚠ Supabase Auth 의 Redirect URLs 에 `https://<배포 호스트>/auth/callback` 을 더해야 구글 로그인이 돌아온다.
#    대시보드의 「Confirm email」도 켜져 있어야 한다(INV-ACCESS-08).

# ── 배포에 넣지 않는 것 ──────────────────────────────────────────────────
#
# ALLOW_LOCAL_ACCOUNTS=1
#   프로덕션 빌드에서 로컬 계정 로그인 칸을 여는 유일한 스위치다(`src/lib/localAccounts.ts`).
#   배포 환경변수에 들어가면 시드 계정으로 누구나 들어온다.
