# agent 앱의 환경 변수 본보기.
#
# `cp apps/agent/.env.example apps/agent/.env.development.local` 로 복사하면
# `npx turbo dev --filter=@hathway/agent` 가 바로 돈다(포트 4410). 아래 값은 로컬 스택의
# 기본값이고 비밀이 아니다.
#
# ⚠ `.env.development.local` 은 `next dev` 전용이다. `next build` 와 `next start` 는 읽지 않는다.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54361
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# `pg` 로 직결한다. 접속 롤은 `agent_app` 이고 로컬 비밀번호는 `supabase/seed.sql` 이 넣는다.
AGENT_DATABASE_URL=postgresql://agent_app:postgres@127.0.0.1:54362/postgres

# ⚠ **게이트웨이 키를 넣기 전에는 연습 실행기로 띄운다.** 워크플로는 그대로 돌고 모델만 정해진 답을 내는
#    가짜로 바뀐다(`src/workflows/rehearsalModel.ts`). 키를 넣었으면 이 줄을 지운다.
AGENT_RUNNER=rehearsal

# ── 실물 모델 ──────────────────────────────────────────────────────────────
#
# AI_GATEWAY_API_KEY=<게이트웨이 키>
#   로컬에서 실물 모델을 부를 때만 넣는다. 터미널에서 직접 `.env.local` 에 적는다.
#   Vercel 에 배포하면 게이트웨이가 OIDC 로 붙으므로 넣지 않아도 된다.
#
# AGENT_MODEL=anthropic/claude-sonnet-5.5
#   게이트웨이의 모델 이름. 비우면 `src/lib/model.ts` 의 기본값이다.

# ── 배포에 넣지 않는 것 ──────────────────────────────────────────────────
#
# ALLOW_LOCAL_ACCOUNTS=1   프로덕션 빌드에서 로컬 계정 칸을 여는 e2e 전용 스위치다.
# EXPOSE_TESTING_API=1     e2e 가 쓰는 테스트 API 를 연다.
# AGENT_RUNNER=rehearsal   모델을 부르지 않는 연습 실행기다. 배포에 들어가면 에이전트가 정해진 답만 한다.
