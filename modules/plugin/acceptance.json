{
    "//": "이 모듈을 붙이거나 뗀 뒤 반드시 지나야 할 검사. 붙였으면 전부, 뗐으면 checks 와 코어의 검사(turbo typecheck test · web e2e)가 초록이어야 한다.",
    "checks": [
        { "cwd": ".", "run": "npm run check:modules -w @hathway/shared" },
        { "cwd": ".", "run": "npm run check:dependencies -w @hathway/shared" },
        { "cwd": ".", "run": "npm run check:invariants -w @hathway/shared" },
        { "cwd": ".", "run": "npm run check:comments -w @hathway/shared" },
        { "cwd": ".", "run": "npx turbo typecheck" }
    ],
    "unit": [
        { "cwd": "packages/preferences", "run": "npx vitest run" },
        { "cwd": "apps/web", "run": "npx vitest run src/modules/plugin src/extensions src/usecases/mcp.test.ts src/lib/mcp.test.ts" }
    ],
    "contract": [
        { "cwd": "packages/adapters-postgres", "run": "npx vitest run src/preferences", "needs": "supabase start" }
    ],
    "e2e": [
        { "cwd": "apps/web", "run": "npm run e2e -- plugin.spec.ts mcp.spec.ts", "needs": "supabase start" }
    ]
}
